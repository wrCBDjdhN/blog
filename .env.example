# Database - Neon PostgreSQL
DATABASE_URL="postgresql://neondb_owner:你的密码@ep-xxx.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="运行 node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\" 生成"
NEXTAUTH_URL="https://你的vercel域名.vercel.app"

# imgbb (免费图床)
IMGBB_API_KEY="从 https://imgbb.com 获取"

# Init Secret
INIT_SECRET="运行 node -e \"console.log(require('crypto').randomBytes(16).toString('hex'))\" 生成"

# 初始化开关：初始化完成后设为 true 锁定 /api/init 端点（V7 修复）
INIT_DISABLED="false"

# CORS 允许源（V8 修复）：仅当显式配置时才下发 CORS 头。
# 多个源用逗号分隔，例如 https://wrcbdjdh.cloud,https://www.example.com
# 切勿使用 "*"，特别是在 Access-Control-Allow-Credentials: true 时。
ALLOWED_ORIGIN="https://wrcbdjdh.cloud"

# Admin Account（seed 必须显式提供；缺失则 seed 报错退出，V2 修复）
ADMIN_EMAIL="你的邮箱"
ADMIN_PASSWORD="你的密码（至少 12 位）"
